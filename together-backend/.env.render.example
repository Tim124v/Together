# Справка для Render Environment (не коммитить секреты).
# PORT и RENDER_EXTERNAL_URL подставляет Render. DATABASE_URL — из Postgres-сервиса.

NODE_ENV=production
DB_DIALECT=postgres
DB_SYNC=sync
PGSSL=true

DATABASE_URL=postgres://together_user:PASSWORD@dpg-xxxx-a/together

JWT_ACCESS_SECRET=openssl-rand-hex-32
JWT_REFRESH_SECRET=another-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10

# После деплоя Vercel подставьте точный URL фронта:
CORS_ORIGIN=https://YOUR-APP.vercel.app

# Публичный URL API (onrender.com). Если пусто — возьмётся RENDER_EXTERNAL_URL.
PUBLIC_API_URL=https://together-api.onrender.com
