PORT=5050
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
# CORS_ORIGIN=https://together-app.vercel.app,http://localhost:3000

# sqlite (по умолчанию) или postgres
DB_DIALECT=sqlite
SQLITE_PATH=./data/together.sqlite
#
# Production / Railway:
# NODE_ENV=production
# PORT=5000
# DB_DIALECT=postgres
# DATABASE_URL=postgres://user:pass@host:5432/together
# CORS_ORIGIN=https://together-app.vercel.app
# PUBLIC_API_URL=https://together-api.up.railway.app
# JWT_ACCESS_SECRET=<случайная строка 32+ символов>
# JWT_REFRESH_SECRET=<другая случайная строка 32+ символов>

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=30d

BCRYPT_ROUNDS=10
SEED_PASSWORD=together123
