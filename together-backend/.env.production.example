# Справка для Railway Variables (не коммитить секреты)
NODE_ENV=production
# PORT задаёт Railway
DB_DIALECT=postgres
# DATABASE_URL подставит Postgres-сервис Railway
CORS_ORIGIN=https://YOUR-APP.vercel.app
PUBLIC_API_URL=https://YOUR-SERVICE.up.railway.app
JWT_ACCESS_SECRET=generate-32-plus-random-chars
JWT_REFRESH_SECRET=another-32-plus-random-chars
JWT_ACCESS_EXPIRES=24h
JWT_REFRESH_EXPIRES=30d
BCRYPT_ROUNDS=10
DB_SYNC=sync
PGSSL=true
